{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "public", "source", "migration", "playwright-report", "test-results"],
  "compilerOptions": {
    "jsx": "react-jsx",
