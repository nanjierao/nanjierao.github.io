  :root.js .sk:not([data-failed]) .sk__scene:not([data-sampled]) .sk__sample-note,
  :root.js .sk:not([data-failed]) .sk__scene[data-sampled] .sk__tally,
  :root:not(.js) .sk__tally,
  .sk[data-failed] .sk__tally {
    visibility: hidden;
  }

  /* ------------------------------------------------------------ results */

  /* The results keep their space from the start, so nothing moves when they arrive. Until
