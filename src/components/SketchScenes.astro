  .sk__mark input:disabled,
  .sk__choice input:disabled,
  .sk__switch input:disabled {
    cursor: default;
  }

  .sk__mark-face,
  .sk__choice-face,
  .sk__switch-face {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 40px;
    padding: 0 var(--space-2);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
  }

  .sk__mark-face {
    font-size: 1.15rem;
  }

  .sk__choice-face {
    min-width: 64px;
    color: var(--color-text);
  }

  .sk__switch-face {
    min-width: 52px;
    border-radius: 999px;
  }

  .sk__mark input:focus-visible + .sk__mark-face,
  .sk__choice input:focus-visible + .sk__choice-face,
  .sk__switch input:focus-visible + .sk__switch-face {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  /* Chosen: filled, so the state shows in light and dark, with ✓ and ✗ telling the two apart. */
  .sk__mark input:checked + .sk__mark-face,
  .sk__switch input:checked + .sk__switch-face {
    color: var(--color-bg);
    font-weight: 700;
  }

  .sk__mark--yes input:checked + .sk__mark-face,
  .sk__switch input:checked + .sk__switch-face {
    border-color: var(--color-sketch-yes);
    background: var(--color-sketch-yes);
  }

  .sk__mark--no input:checked + .sk__mark-face {
    border-color: var(--color-sketch-no);
    background: var(--color-sketch-no);
  }

  .sk__choice input:checked + .sk__choice-face {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .sk__mark input:disabled:not(:checked) + .sk__mark-face,
  .sk__choice input:disabled:not(:checked) + .sk__choice-face {
    opacity: 0.45;
  }

  .sk__switch-off,
  .sk__switch input:not(:checked) + .sk__switch-face .sk__switch-on {
    display: none;
  }

  .sk__switch input:not(:checked) + .sk__switch-face .sk__switch-off {
    display: inline;
  }

  .sk__task {
    margin-top: var(--space-3);
  }

  /* The tracker's pop-up, drawn as a small window. */
  .sk__popup {
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius);
    background: var(--color-bg);
    box-shadow: 3px 3px 0 var(--color-ink);
