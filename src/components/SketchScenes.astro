    .sk__panel {
      grid-column: 1;
      grid-row: auto;
      margin-top: var(--space-4);
    }

    .sk__ctl {
      margin-left: 0;
    }
  }

  /* On a phone held upright the controls are a screen below the drawing they change. The
     drawing therefore stays at the top of the window while its captions and panel pass under
     it, so the visitor sees the puppet turn and the map cell change. */
  @media (max-width: 56rem) and (orientation: portrait) {
    :root.js .sk:not([data-failed]) .sk__board {
      position: sticky;
      top: 0;
      z-index: 2;
      border-radius: 0;
      box-shadow: 0 1.5px 0 var(--color-border);
