  .sk__popup legend {
    float: left;
    width: 100%;
    margin: 0 0 var(--space-2);
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .sk__choices {
    display: flex;
    gap: var(--space-2);
    clear: both;
  }

  /* The options of a pick: plain, like the other controls of the panel, and as many lines
     as a long option needs. */
  .sk__pick {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sk__pick legend {
    margin: 0 0 var(--space-2);
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .sk__pick .sk__choices {
    flex-wrap: wrap;
  }

  .sk__pick .sk__choice {
    max-width: 100%;
  }

  .sk__pick .sk__choice-face {
    height: auto;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    line-height: 1.3;
    text-align: start;
  }

  .sk__status {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
  }

  .sk__action + .sk__status {
    margin-top: var(--space-2);
  }

  .sk__sample-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The sample note shows only where sample answers are on screen: always without JavaScript,
