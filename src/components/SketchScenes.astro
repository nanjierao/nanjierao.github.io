  /* High-contrast mode: the system's colors, and no pale fills behind the lines. */
  @media (forced-colors: active) {
    .sk__ink,
    .sk__wire,
    .sk__glyph {
      stroke: CanvasText;
    }

    .sk__fill {
      fill: none;
    }

    /* The open scene's button and the confirmed map cell must not rest on a fill or a shadow. */
    .sk__tab[aria-pressed='true'] {
      border-width: 3px;
      border-color: Highlight;
      background: Highlight;
      color: HighlightText;
      forced-color-adjust: none;
    }

    /* forced-color-adjust: none keeps the site's focus color too; use the system's. */
    .sk__tab[aria-pressed='true']:focus-visible {
