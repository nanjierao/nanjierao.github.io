---
// Publications by year: one chip per paper, filled for first-author work, outlined otherwise.
// Columns of chips on wide screens (a histogram), rows on a phone. Every chip links to its
// entry in the list below. Years with no paper stay on the axis, so gaps aren't hidden.
import type { Publication } from '../../lib/content.ts';

interface Props {
  publications: Publication[];
}

const { publications } = Astro.props;
const dated = publications.filter((pub) => pub.year !== undefined);
const years = dated.map((pub) => pub.year!);
const first = Math.min(...years);
const last = Math.max(...years);
const columns = Array.from({ length: last - first + 1 }, (_, i) => {
  const year = first + i;
  return { year, pubs: dated.filter((pub) => pub.year === year) };
});
const tallest = Math.max(...columns.map((column) => column.pubs.length));
---

<div class="pubtl" style={`--tallest: ${tallest}`}>
  <ol class="pubtl__years">
    {columns.map(({ year, pubs }) => (
      <li class="pubtl__year">
        <span class="pubtl__label">{year}</span>
        {pubs.length > 0 ? (
          <ul class="pubtl__pubs">
            {pubs.map((pub) => (
              <li>
                <a
                  class:list={['pubtl__chip', { 'pubtl__chip--first': pub.firstAuthor }]}
                  href={`#${pub.id}`}
                >
                  {pub.venueShort ?? pub.venue}
                  <span class="visually-hidden">
                    : {pub.title} ({pub.firstAuthor ? 'first author' : 'co-author'})
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <span class="visually-hidden">no papers</span>
        )}
      </li>
    ))}
  </ol>
  <p class="pubtl__key" aria-hidden="true">
    <span class="pubtl__chip pubtl__chip--first">Filled</span> first author
    <span class="pubtl__chip">Outlined</span> co-author
  </p>
</div>

<style>
  .pubtl__years {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pubtl__year {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    min-height: 2rem;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: var(--space-2);
  }

  .pubtl__label {
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .pubtl__pubs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pubtl__pubs li {
    margin: 0;
  }

  /* Wide screens: a column per year, chips stacked from the axis up. */
  @media (min-width: 40rem) {
    .pubtl__years {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      align-items: end;
      gap: var(--space-2);
    }

    .pubtl__year {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      align-items: end;
      min-height: calc(var(--tallest) * 2.25rem + 2rem);
      padding: 0;
      border-bottom: 0;
    }

    .pubtl__pubs {
      grid-row: 1;
      flex-direction: column-reverse;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: var(--space-1);
    }

    .pubtl__label {
      grid-row: 2;
      padding-top: var(--space-2);
      border-top: 2px solid var(--color-text-muted);
      text-align: center;
    }

    .pubtl__chip {
      display: block;
      text-align: center;
    }
  }

  .pubtl__chip {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--color-series-a);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .pubtl__chip--first {
    background: var(--color-series-a);
    color: var(--color-bg);
  }

  a.pubtl__chip:hover {
    text-decoration: underline;
  }

  .pubtl__key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pubtl__key .pubtl__chip {
    display: inline-block;
    margin-left: var(--space-2);
  }

  .pubtl__key .pubtl__chip:first-child {
    margin-left: 0;
  }
</style>
