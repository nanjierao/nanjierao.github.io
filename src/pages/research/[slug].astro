---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuildCard from '../../components/BuildCard.astro';
import PublicationList from '../../components/PublicationList.astro';
import { SCENES, TEACHER_SCENES, TEACHER_SCENES_NOTE } from '../../data/sketch-scenes.ts';
import { CONTEXT_LABELS, ONGOING_LABEL } from '../../content/schemas.ts';
import { getBuildsByIds, getPublicationsByIds, getThemes, type Theme } from '../../lib/content.ts';

export const getStaticPaths = (async () => {
  const themes = await getThemes();
  return themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}) satisfies GetStaticPaths;

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
const { Content } = await render(theme);
const publications = await getPublicationsByIds(theme.data.publications);
const builds = await getBuildsByIds(theme.data.builds);
/** The teacher scenes, which live on the home page (D76); this page lists them. */
const teacherScenes = TEACHER_SCENES.map((id) => SCENES.find((scene) => scene.id === id)!);
---

<BaseLayout title={theme.data.title} description={theme.data.summary}>
  <p class="breadcrumb">
    <a href="/research/">Research</a> ·{' '}
    {theme.data.context ? CONTEXT_LABELS[theme.data.context] : ONGOING_LABEL}
  </p>
  <h1>{theme.data.title}</h1>
  {theme.data.lede && <p class="lede">{theme.data.summary}</p>}
  <div class="prose prose--wide">
    <Content />
  </div>

  {theme.data.scenes === 'teachers' && (
    <section class="theme-scenes" id="scenes" aria-labelledby="theme-scenes">
      <h2 id="theme-scenes">One scene per paper, and a pilot</h2>
      {/* The scenes moved to the home page (D76). An old link to one of them here, such as
          #sk-zoom, still lands on its line below, and with JavaScript it opens the scene. */}
      <script is:inline>
        if (/^#sk-[a-z]+$/.test(location.hash)) location.replace('/' + location.hash);
      </script>
      <p>{TEACHER_SCENES_NOTE}</p>
      <ul class="theme-scenes__list">
        {teacherScenes.map((scene) => (
          <li id={`sk-${scene.id}`}>
            <a href={`/#sk-${scene.id}`}>{scene.label}</a>: {scene.heading}
          </li>
        ))}
      </ul>
    </section>
  )}

  {publications.length > 0 && (
    <section aria-labelledby="theme-publications">
      <h2 id="theme-publications">Publications</h2>
      <PublicationList publications={publications} />
    </section>
  )}

  {builds.length > 0 && (
    <section aria-labelledby="theme-builds">
      <h2 id="theme-builds">Builds</h2>
      <ul class="card-grid">
        {builds.map((build) => (
          <li>
            <BuildCard build={build} />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  /* An old link to a teacher scene on this page (#sk-zoom) lands on its line: mark it. */
  .theme-scenes__list li:target {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius);
  }
</style>
