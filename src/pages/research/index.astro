---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/figures/Figure.astro';
import Flow from '../../components/figures/Flow.astro';
import { UMBRELLA } from '../../data/site.ts';
import { CONTEXT_LABELS } from '../../content/schemas.ts';
import { getThemesByContext } from '../../lib/content.ts';

const contexts = await getThemesByContext();
---

<BaseLayout
  title="Research"
  description="Research overview: where an AI system’s knowledge of a person should come from, in personal, embodied and civic contexts."
>
  <h1>Research</h1>
  <p class="visually-hidden">{UMBRELLA}</p>

  <div class="research-map">
    <Figure title="The question behind the work">
      <Flow
        label="The question behind the work"
        steps={[
          {
            title: 'An AI system that adapts to a person first needs to know something about them',
            items: [
              { term: 'By asking', detail: 'what the person tells it' },
              { term: 'By reading records', detail: 'what the person already produced' },
            ],
          },
          {
            title: 'My research asks',
            items: [
              { term: 'Which to rely on?' },
              { term: 'How accurate and well grounded is the result?' },
              { term: 'What does it cost in privacy?' },
            ],
          },
        ]}
      />
    </Figure>
  </div>
  <p class="prose">
    The work falls under three contexts: personal (what systems learn about a student or user),
    embodied (learning through hands, puppets, avatars and devices), and civic (crowd-sourced urban
    digital twins).
  </p>

  {contexts.map(({ context, themes }) => (
    <section aria-labelledby={`context-${context}`}>
      <h2 id={`context-${context}`}>{CONTEXT_LABELS[context]}</h2>
      <ul class="card-grid">
        {themes.map((theme) => (
          <li>
            <article class="card">
              <h3>
                <a href={`/research/${theme.id}/`}>{theme.data.title}</a>
              </h3>
              <p>{theme.data.summary}</p>
            </article>
          </li>
        ))}
      </ul>
      {context === 'personal' && (
        <>
          <h3>Also: explanation and recommendation</h3>
          <ul class="section-list">
            <li>
              Explanation types and user motivations in recommender systems (AAAI HCOMP 2020,
              co-author).
            </li>
            <li>
              Everyday-inspired movie recommendation from personal social media (IFIP INTERACT 2023,
              co-author).
            </li>
          </ul>
          <p>
            Both are listed on the <a href="/publications/">publications page</a>.
          </p>
        </>
      )}
    </section>
  ))}
</BaseLayout>

<style>
  .research-map {
    max-width: 48rem;
  }
</style>
