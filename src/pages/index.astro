---
// Homepage until S3 (D21: intro strip first, then the word cloud). The portals and the easter
// egg arrive with the chosen design (S2, S3).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChineseName from '../components/ChineseName.astro';
import ElsewhereLinks from '../components/ElsewhereLinks.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import LatestVideo from '../components/LatestVideo.astro';
import LearnersTeachers from '../components/LearnersTeachers.astro';
import TimeAware from '../components/TimeAware.astro';
import WordCloud from '../components/WordCloud.astro';
import { HEADSHOT_ALT, PERSON, POSITIONING, UMBRELLA } from '../data/site.ts';
import { STATUS } from '../data/cv.ts';
import { CONTEXT_LABELS, ONGOING_LABEL } from '../content/schemas.ts';
import {
  getNews,
  getNotes,
  getOngoingThemes,
  getPosts,
  getThemesByContext,
} from '../lib/content.ts';
import { noteLine } from '../lib/notes.ts';
import { getExternalData } from '../lib/external.ts';
import { formatDay, formatPartialDate, isoDay } from '../lib/format.ts';
import { CV_PDF_HREF, hasCvPdf } from '../lib/cv-pdf.ts';
import { personJsonLd } from '../lib/seo.ts';
import headshot from '../assets/images/nanjie-rao-headshot.jpg';

const contexts = await getThemesByContext();
const ongoing = await getOngoingThemes();
const news = await getNews(3);
const [latestPost] = await getPosts();
const [latestNote] = await getNotes();
const external = getExternalData();
const cvPdf = hasCvPdf();
// Status line (D21): none until Jimmy approves one in facts.md §2. TODO(jimmy)
---

<BaseLayout description={POSITIONING} jsonLd={personJsonLd()} ogType="profile">
  <section class="intro" aria-labelledby="intro-name">
    <h1 id="intro-name">
      {PERSON.displayName} <ChineseName />
    </h1>
    <Image
      class="intro__photo"
      src={headshot}
      alt={HEADSHOT_ALT}
      width={144}
      height={144}
      densities={[1, 2]}
      loading="eager"
    />
    <p class="intro__role">
      {STATUS.role}
      <TimeAware
        start={STATUS.degreeMonth.start}
        end={STATUS.degreeMonth.end}
        upcoming={` (${STATUS.degreeNote})`}
        past=""
      />
      {' · '}
      <a href={STATUS.labUrl}>{STATUS.labShort}</a>, advised by{' '}
      <a href={STATUS.advisorUrl}>{STATUS.advisor}</a>
    </p>
    <p class="intro__line">{POSITIONING}</p>
    <ul class="intro__actions" aria-label="Quick links">
      <li>
        <a class="button button--primary" href={cvPdf ? CV_PDF_HREF : '/cv/'}>
          {cvPdf ? 'CV (PDF)' : 'CV'}
        </a>
      </li>
      <li>
        <a class="button" href="/publications/">
          Publications
        </a>
      </li>
      {PERSON.email && (
        <li>
          <a class="button" href={`mailto:${PERSON.email}`}>
            Email
          </a>
        </li>
      )}
    </ul>
    <div class="intro__links">
      <ElsewhereLinks label="Elsewhere" />
    </div>
  </section>

  <section aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="visually-hidden">
      Topics
    </h2>
    <WordCloud />
  </section>

  <LearnersTeachers />

  <section aria-labelledby="research-heading">
    <h2 id="research-heading">Research</h2>
    <p class="prose">{UMBRELLA}</p>
    <div class="contexts">
      {contexts.map(({ context, themes }) => (
        <section class="context" aria-labelledby={`context-${context}`}>
          <h3 id={`context-${context}`}>{CONTEXT_LABELS[context]}</h3>
          <ul class="plain-list">
            {themes.map((theme) => (
              <li>
                <a href={`/research/${theme.id}/`}>{theme.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    {ongoing.length > 0 && (
      <section class="context" aria-labelledby="context-ongoing">
        <h3 id="context-ongoing">{ONGOING_LABEL}</h3>
        <ul class="plain-list">
          {ongoing.map((theme) => (
            <li>
              <a href={`/research/${theme.id}/`}>{theme.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <p>
      <a href="/research/">Research overview</a>
    </p>
  </section>

  <section aria-labelledby="recent-heading">
    <h2 id="recent-heading">Recent</h2>
    <ol class="news plain-list">
      {news.map((item) => (
        <li class="news__item">
          <span class="news__date muted small">
            <time datetime={item.date}>{formatPartialDate(item.date)}</time>
          </span>{' '}
          <span class="news__text">
            {item.event ? (
              <TimeAware
                start={item.event.start}
                end={item.event.end}
                timeZone={item.event.timeZone}
                upcoming={item.event.upcoming}
                ongoing={item.event.ongoing}
                past={item.event.past}
              />
            ) : (
              item.text
            )}
            {item.link && (
              <>
                {' '}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </span>
        </li>
      ))}
    </ol>

    <div class="recent-grid">
      <section class="card" aria-labelledby="daily-notes">
        <h3 id="daily-notes">
          <a href="/notes/">Daily notes</a>
        </h3>
        {latestNote ? (
          <>
            <p class="muted small">
              <time datetime={latestNote.id}>{formatPartialDate(latestNote.id)}</time>
            </p>
            <ul class="daily-note small">
              {latestNote.data.lines.map((line) => {
                const { lang, runs } = noteLine(line);
                return (
                  <li lang={lang}>
                    {runs.map((run) =>
                      run.lang ? <span lang={run.lang}>{run.text}</span> : run.text,
                    )}
                  </li>
                );
              })}
            </ul>
          </>
        ) : (
          <p class="small">
            A date and three short sentences a day: what I did, and what I learned.
          </p>
        )}
      </section>
      {latestPost && (
        <section class="card" aria-labelledby="latest-post">
          <h3 id="latest-post">Latest blog post</h3>
          <p>
            <a href={`/blog/${latestPost.id}/`}>{latestPost.data.title_en}</a>
            <span class="muted small">
              {' '}
              ·{' '}
              <time datetime={isoDay(latestPost.data.date)}>{formatDay(latestPost.data.date)}</time>
            </span>
          </p>
          <p class="small">{latestPost.data.summary_en}</p>
        </section>
      )}
      {external.youtube && (
        <section class="card" aria-labelledby="latest-video">
          <h3 id="latest-video">Latest video</h3>
          <LatestVideo youtube={external.youtube} />
        </section>
      )}
      <section class="card" aria-labelledby="github-activity">
        <h3 id="github-activity">On GitHub</h3>
        <GitHubActivity
          activity={external.github?.activity ?? []}
          allowedRepos={
            external.github
              ? [
                  ...external.github.activity.map((item) => item.repo),
                  ...external.github.repos.map((repo) => repo.fullName),
                ]
              : null
          }
        />
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  /* Who, where, what: on a phone the photo sits beside the name; from 48rem up it moves to the
     right of the text, which keeps its measure. */
  .intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'photo name'
      'role role'
      'line line'
      'actions actions'
      'links links';
    column-gap: var(--space-4);
    align-items: center;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }

  .intro :global(.intro__photo) {
    grid-area: photo;
    width: 4.5rem;
    height: auto;
    border-radius: var(--radius);
  }

  .intro h1 {
    grid-area: name;
    margin: 0;
    /* Two names, not a title: break between them, not inside the English one. */
    text-wrap: wrap;
    overflow-wrap: anywhere;
  }

  .intro__role {
    grid-area: role;
    max-width: 42rem;
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .intro__line {
    grid-area: line;
    font-size: var(--text-lg);
    max-width: 42rem;
    margin: var(--space-3) 0 var(--space-5);
  }

  .intro__actions {
    grid-area: actions;
  }

  .intro__links {
    grid-area: links;
  }

  @media (min-width: 48rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'name photo'
        'role photo'
        'line photo'
        'actions photo'
        'links photo';
      column-gap: var(--space-6);
      align-items: start;
    }

    .intro :global(.intro__photo) {
      width: 9rem;
    }

    .intro__role {
      font-size: inherit;
    }
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .intro__actions li {
    margin: 0;
  }

  .contexts {
    display: grid;
    gap: var(--space-2) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .context h3 {
    margin-top: var(--space-4);
  }

  .news {
    max-width: var(--measure);
  }

  .news__item {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-4);
    margin: 0 0 var(--space-4);
  }

  .news__date {
    padding-top: 0.2em;
  }

  @media (max-width: 36rem) {
    .news__item {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .recent-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-top: var(--space-5);
  }

  .recent-grid h3 {
    margin-top: 0;
  }

  .daily-note {
    margin: 0;
    padding-left: var(--space-4);
    /* A long link or code name in a note wraps instead of making a phone page scroll sideways. */
    overflow-wrap: anywhere;
  }

  .daily-note li + li {
    margin-top: var(--space-1);
  }

  /* A Chinese phrase inside an English line keeps the line's spacing. */
  .daily-note span[lang] {
    line-height: inherit;
  }
</style>
