---
// One line of work across the papers (D66): observing learners, the teacher's side, and the
// checks. The copy lives in src/data/learners-teachers.ts so a test can read all of it; the
// citations come from the publication list the rest of the site uses.
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/figures/Figure.astro';
import Flow from '../components/figures/Flow.astro';
import PairedBars from '../components/figures/PairedBars.astro';
import PublicationList from '../components/PublicationList.astro';
import { STUDY2_SOURCES } from '../data/figures.ts';
import {
  BREADTH_INTRO,
  BREADTH_PUBLICATIONS,
  DESCRIPTION,
  GROUNDING_NOTE,
  INTRO,
  LEARNER_STUDIES,
  LEDE,
  MORE_INTRO,
  STEPS,
  TEACHER_INTRO,
  TEACHER_ITEMS,
  TEACHER_PUBLICATIONS,
  TITLE,
} from '../data/learners-teachers.ts';
import { getPublicationsByIds } from '../lib/content.ts';
import { CV_PDF_HREF, hasCvPdf } from '../lib/cv-pdf.ts';

const teacherPapers = await getPublicationsByIds(TEACHER_PUBLICATIONS);
const breadthPapers = await getPublicationsByIds(BREADTH_PUBLICATIONS);
const cvPdf = hasCvPdf();
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <h1>{TITLE}</h1>
  <p class="lede">{LEDE}</p>
  <div class="prose">
    {INTRO.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>

  <Figure title="Observe, model, check">
    <Flow label="Observe, model, check" steps={STEPS} />
  </Figure>

  <section aria-labelledby="learners-heading">
    <h2 id="learners-heading">Observing learners</h2>
    <ul class="studies">
      {LEARNER_STUDIES.map((study) => (
        <li class="study" id={study.id}>
          <h3 class="study__title">{study.title}</h3>
          <p class="study__where small muted">{study.where}</p>
          <dl class="study__facts">
            <dt>Observed</dt>
            <dd>{study.observed}</dd>
            <dt>Who</dt>
            <dd>{study.who}</dd>
            <dt>Found</dt>
            <dd>{study.found}</dd>
          </dl>
          <ul class="study__links">
            {study.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <h3 id="worth-heading">What the observations are worth</h3>
    <Figure
      title="Browsing history compared with social-media posts (IEEE ICALT 2026)"
      note="32 participants after data-quality screening. Students confirmed or rejected each interest the LLM extracted."
    >
      <PairedBars series={STUDY2_SOURCES.series} metrics={STUDY2_SOURCES.metrics} />
    </Figure>
    <div class="prose">
      {GROUNDING_NOTE.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>
        <a href="/research/grounding/">How the grounding check works</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="teachers-heading">
    <h2 id="teachers-heading">Modeling teachers</h2>
    <p class="prose">{TEACHER_INTRO}</p>
    <dl class="teacher-items">
      {TEACHER_ITEMS.map((item) => (
        <div class="teacher-item">
          <dt>
            {item.lead} <span class="small muted">{item.where}</span>
          </dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
    <h3 id="teacher-papers-heading">The three papers</h3>
    <PublicationList publications={teacherPapers} compact />
    <p>
      <a href="/research/teacher-support/">Teacher support technologies</a>
    </p>
  </section>

  <section aria-labelledby="breadth-heading">
    <h2 id="breadth-heading">Supporting breadth</h2>
    <p class="prose">{BREADTH_INTRO}</p>
    <PublicationList publications={breadthPapers} compact />
  </section>

  <section aria-labelledby="more-heading">
    <h2 id="more-heading">CV and publications</h2>
    <p class="prose">{MORE_INTRO}</p>
    <ul class="more-actions">
      <li>
        <a class="button button--primary" href={cvPdf ? CV_PDF_HREF : '/cv/'}>
          {cvPdf ? 'CV (PDF)' : 'CV'}
        </a>
      </li>
      <li>
        <a class="button" href="/publications/">
          Publications
        </a>
      </li>
      <li>
        <a class="button" href="/research/">
          Research overview
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .studies {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .study {
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .study__title {
    margin: 0;
    font-size: 1.1rem;
  }

  .study__where {
    margin: var(--space-1) 0 var(--space-3);
  }

  .study__facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-3);
  }

  .study__facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .study__facts dd {
    margin: 0;
  }

  .study__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .study__links li {
    margin: 0;
  }

  .study__links a {
    display: inline-block;
    padding-block: var(--space-1);
  }

  .teacher-items {
    max-width: var(--measure);
    margin: var(--space-4) 0 var(--space-5);
  }

  .teacher-item {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-rule);
  }

  .teacher-item dt {
    font-weight: 600;
  }

  .teacher-item dt span {
    font-weight: 400;
  }

  .teacher-item dd {
    margin: var(--space-1) 0 0;
  }

  .more-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-actions li {
    margin: 0;
  }
</style>
