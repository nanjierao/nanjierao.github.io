---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stats from '../components/figures/Stats.astro';
import { EARLIER_TEACHING, TEACHING_ASSISTANT, TEACHING_INTERESTS } from '../data/cv.ts';

// facts.md §8.
const stats = [
  { value: 'about 150', label: 'students across my COP 3530 discussion sections (Fall 2026)' },
  { value: '2', label: 'graduate courses co-taught: HCI and Research Methods' },
];
---

<BaseLayout
  title="Teaching"
  description="Teaching by Nanjie (Jimmy) Rao: data structures discussion sections and co-taught graduate HCI and research methods at the University of Florida, plus earlier teaching and tutoring."
>
  <h1>Teaching</h1>
  <p class="lede">
    {TEACHING_ASSISTANT.role}, {TEACHING_ASSISTANT.where}, {TEACHING_ASSISTANT.when}.
  </p>

  <Stats stats={stats} />

  <section aria-labelledby="uf-heading">
    <h2 id="uf-heading">University of Florida</h2>
    <div class="table-wrap teaching-table">
      <table>
        <thead>
          <tr>
            <th scope="col">Course</th>
            <th scope="col">Role</th>
          </tr>
        </thead>
        <tbody>
          {TEACHING_ASSISTANT.items.map((item) => (
            <tr>
              <th scope="row">
                {item.course}
                {item.term && <span class="teaching-table__term">{item.term}</span>}
              </th>
              <td>{item.details}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="earlier-heading">
    <h2 id="earlier-heading">Before UF</h2>
    <ul class="section-list">
      {EARLIER_TEACHING.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="interests-heading">
    <h2 id="interests-heading">Teaching interests</h2>
    <ul class="tag-list teaching-interests">
      {TEACHING_INTERESTS.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .teaching-table {
    max-width: 56rem;
  }

  .teaching-table th[scope='row'] {
    width: 40%;
  }

  .teaching-table__term {
    display: block;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .teaching-interests li {
    font-size: var(--text-base);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text);
  }
</style>
